[41.406, "o", "    \"lg-08-screening-schedule\"\r\n"]
[41.406, "o", "  ],\r\n"]
[41.406, "o", "  \"rationale\": \"This fits your elevated blood glucose, current steps of about 3,100 a day, High screening risk, and hazy conditions in the North region. The activity is indoors and near Woodlands.\",\r\n"]
