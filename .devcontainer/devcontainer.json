{
  "name": "livewell-foundry-workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "containerEnv": {
    "PYTHONIOENCODING": "utf-8"
  },
  "remoteEnv": {
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "python3 -m venv .venv && uv pip install --python .venv/bin/python -r requirements.txt ms-fabric-cli==1.7.0",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.azure-dev",
        "redhat.vscode-yaml"
      ]
    }
  }
}
