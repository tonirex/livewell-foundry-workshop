{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiveWell answer key",
  "type": "object",
  "required": [
    "lab",
    "checkpoints"
  ],
  "properties": {
    "lab": {
      "type": "string",
      "pattern": "^lab-0[0-4]$"
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "validation_type",
          "notes",
          "expected_ref"
        ],
        "properties": {
          "prompt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "validation_type": {
            "enum": [
              "A_paste_output",
              "B_trace_field",
              "C_paste_metric"
            ]
          },
          "notes": {
            "type": "string"
          },
          "expected_ref": {
            "type": "string"
          },
          "checkpoint_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
