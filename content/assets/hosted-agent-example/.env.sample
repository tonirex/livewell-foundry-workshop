# Local runs only (azd ai agent run). Deployed, the platform injects FOUNDRY_PROJECT_ENDPOINT and azure.yaml
# sets the rest from the azd env. Copy to .env (git-ignored) and fill in from `azd env get-values`.
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=model-router
