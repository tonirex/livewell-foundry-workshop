# LiveWell Builder rail settings. Copy to content/assets/.env (gitignored) and fill in from the
# facilitator values sheet. Names only in lab pages; values live here and on the values sheet.

# Your initials: 2-8 letters or digits. Your agents are named livewell-<INITIALS>-<role>.
INITIALS=abc

# "Project endpoint" row on the values sheet.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/livewell-workshop

# Set to true only when the facilitator confirms the Fabric step is on (Lab 3 --fabric, Lab 4 insights).
FABRIC_BRIDGE=false

# Optional overrides (defaults come from content/config/workshop.yaml):
# LIVEWELL_MODEL=gpt-5-mini            # Labs 0-2, the Lab 3 specialists and Lab 4
# LIVEWELL_TOOLS_MODEL=gpt-4.1-mini    # the Lab 3 coach (function, OpenAPI, A2A and Fabric tools) and eval judges
# LIVEWELL_REASONING_EFFORT=low        # gpt-5-mini only: minimal, low, medium or high
# LIVEWELL_TIMEOUT=180                 # seconds per agent call
# AZURE_TENANT_ID=                     # only if az login picked a different tenant
