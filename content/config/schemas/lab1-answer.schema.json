{
  "name": "livewell_answer",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string"
      },
      "intent": {
        "type": "string",
        "enum": [
          "nutrition",
          "activity",
          "sleep",
          "screening",
          "rewards",
          "general",
          "out_of_scope"
        ]
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "low",
          "moderate",
          "high"
        ]
      },
      "route": {
        "type": "string",
        "enum": [
          "self_care",
          "activity",
          "clinician",
          "healthhub",
          "emergency",
          "programme_insights",
          "refuse"
        ]
      },
      "cited_sources": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "lg-01-healthy-plate",
            "lg-02-physical-activity-guideline",
            "lg-03-nutri-grade",
            "lg-04-salt-and-sugar-tips",
            "lg-05-eating-for-pre-diabetes",
            "lg-06-exercise-by-condition",
            "lg-07-sleep",
            "lg-08-screening-schedule",
            "lg-09-hazy-day-activity",
            "lg-10-active-after-60",
            "lg-11-faq"
          ]
        }
      },
      "personalisation_flags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "answer",
      "intent",
      "risk_level",
      "route",
      "cited_sources",
      "personalisation_flags"
    ]
  }
}
